# Local secret for the Zenbook client and the gateway.
# Use a long random string before this gateway is reachable off the machine.
SAM_ACCESS_TOKEN=replace-with-a-long-random-string

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8797

ORCH_HOST=127.0.0.1
ORCH_PORT=8788
ORCHESTRATOR_URL=http://127.0.0.1:8788

# Remote GPU. OpenAI-compatible endpoint, for example Ollama:
# MODEL_BASE_URL=http://192.168.1.20:11434/v1
MODEL_BASE_URL=
MODEL_NAME=qwen2.5-coder:14b
