# Local secret for the Zenbook client and the gateway.
# Use a long random string before this gateway is reachable off the machine.
SAM_ACCESS_TOKEN=replace-with-a-long-random-string

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8797

ORCH_HOST=127.0.0.1
ORCH_PORT=8788
ORCHESTRATOR_URL=http://127.0.0.1:8788

# Model brain. Local Ollama by default. Point this at a remote GPU when you have one.
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5-coder:3b
